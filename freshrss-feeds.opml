<?xml version="1.0" encoding="UTF-8"?>
<!--
  Release feeds for the services configured in this repo.

  Import in FreshRSS: Subscription management, then Import / export, then Import.
  A CLI alternative is noted in freshrss.nix.

  Every feed is a GitHub/Codeberg release feed for the upstream project, not the
  distro package, so it tells you what is out there rather than what nixpkgs has.
  frss:ttl="21600" throttles each feed to at most one fetch per 6h; the NixOS
  updater runs every 5 minutes and 40 feeds at that rate would hammer GitHub.
-->
<opml version="2.0" xmlns:frss="https://freshrss.org/opml">
  <head>
    <title>Homeserver service releases</title>
  </head>
  <body>
    <outline text="Releases: Media">
      <outline type="rss" text="Jellyfin" title="Jellyfin"
        description="Media server (services.jellyfin)"
        xmlUrl="https://github.com/jellyfin/jellyfin/releases.atom"
        htmlUrl="https://github.com/jellyfin/jellyfin/releases" frss:ttl="21600" />
      <outline type="rss" text="Seerr (Jellyseerr)" title="Seerr (Jellyseerr)"
        description="Media requests (services.seerr) - project renamed from Jellyseerr to Seerr"
        xmlUrl="https://github.com/seerr-team/seerr/releases.atom"
        htmlUrl="https://github.com/seerr-team/seerr/releases" frss:ttl="21600" />
      <outline type="rss" text="Watcharr" title="Watcharr"
        description="Watch list (podman: ghcr.io/sbondco/watcharr)"
        xmlUrl="https://github.com/sbondCo/Watcharr/releases.atom"
        htmlUrl="https://github.com/sbondCo/Watcharr/releases" frss:ttl="21600" />
      <outline type="rss" text="Navidrome" title="Navidrome"
        description="Music streaming (services.navidrome)"
        xmlUrl="https://github.com/navidrome/navidrome/releases.atom"
        htmlUrl="https://github.com/navidrome/navidrome/releases" frss:ttl="21600" />
      <outline type="rss" text="TubeArchivist" title="TubeArchivist"
        description="YouTube archiving (podman: bbilly1/tubearchivist)"
        xmlUrl="https://github.com/tubearchivist/tubearchivist/releases.atom"
        htmlUrl="https://github.com/tubearchivist/tubearchivist/releases" frss:ttl="21600" />
    </outline>

