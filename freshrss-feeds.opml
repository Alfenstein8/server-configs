        htmlUrl="https://github.com/morpheus65535/bazarr/releases" frss:ttl="21600" />
      <outline type="rss" text="Prowlarr" title="Prowlarr"
        description="Indexer management (podman: lscr.io/linuxserver/prowlarr)"
        xmlUrl="https://github.com/Prowlarr/Prowlarr/releases.atom"
